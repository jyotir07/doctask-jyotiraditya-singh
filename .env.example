# Copy to .env. The suite runs green with this file untouched: the default
# provider is the deterministic fake, so no key is needed to build or test.
DOCTASK_PROVIDER=fake
DOCTASK_DSN=postgresql://doctask:doctask@localhost:5433/doctask
DOCTASK_TEST_DSN=postgresql://doctask:doctask@localhost:5433/doctask_test

# Only needed for a live run. Never commit a real value.
ANTHROPIC_API_KEY=
